+  // FEATURE: while the train is standing at a halt station (arrived, not yet
+  // departed) keep showing "At <station> · departs HH:MM (in N min)" for the
+  // whole halt instead of jumping straight to the next station. Built only
+  // from the stop's own real arrival/departure fields. Null once a real
+  // (non-predicted) departure is recorded, or if no departure time exists.
+  const ltHalt = (() => {
+    if (ltJourneyLikelyComplete || !timeline.length) return null;
+    const isReal = (x) => x && x.actual && x.actual_is_predicted !== true;
+    const at = timeline.find((x) => x.status === "current" && x.kind !== "intermediate" && isReal(x.arrival) && !isReal(x.departure));
+    if (!at) return null;
+    const hhmm = (v) => (v ? String(v).slice(0, 5) : null);
+    const depAt = hhmm(at.departure && (at.departure.expected || at.departure.scheduled));
+    if (!depAt) return null;
+    const left = minutesFromNowClockTime(depAt);
+    return { name: at.name, arrivedAt: hhmm(at.arrival.actual), departsAt: depAt, minsLeft: left != null ? Math.max(0, left) : null };
+  })();
 
